/* 全局样式 */
page {
  background-color: #F5E6D3;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #5D4E37;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
}

/* 通用按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-primary {
  background-color: #4CAF50;
  color: white;
}

.btn-secondary {
  background-color: #8B7355;
  color: white;
}

.btn-disabled {
  background-color: #CCC;
  color: #888;
}

/* 通用卡片样式 */
.card {
  background-color: #FFF8E7;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 通用进度条 */
.progress-bar {
  height: 16rpx;
  background-color: #E0D5C5;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background-color: #4CAF50;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 通用图标容器 */
.icon-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #F5E6D3;
}
